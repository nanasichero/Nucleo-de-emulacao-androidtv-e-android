<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A12"> <!-- Fundo azul escuro/preto clássico do PS3 -->

    <!-- Fundo Dinâmico / Ondas (Pode ser uma imagem de ondas ou gradiente animado) -->
    <ImageView
        android:id="@+id/backgroundWave"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:src="@drawable/bg_wave" />

    <!-- EIXO HORIZONTAL: As Categorias Estilo XMB (Configurações, NDS, Arcade, etc.) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/xmbCategories"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:paddingStart="50dp"
        android:paddingEnd="50dp" />

    <!-- EIXO VERTICAL: Os Jogos/Opções da Categoria Selecionada -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/xmbItemsVertical"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_below="@id/xmbCategories"
        android:layout_marginStart="80dp"
        android:orientation="vertical" />

</RelativeLayout>
